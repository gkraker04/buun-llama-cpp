# Batch × Ubatch performance sweep for buun-llama-cpp
param(
    [string]$Server = "G:\hermes\buun-llama-cpp\build\bin\llama-server.exe",
    [string]$ResultsFile = "",
    [string]$ModelDir = "G:\models\GestaltLabs\Ornstein3.6-27B-MTP-NSC-ACE-SABER-GGUF",
    [string]$Model = "Ornstein3.6-27B-MTP-NSC-ACE-SABER-Q4_K_M-MTP.gguf",
    [string]$MmpRoj = "mmproj-Ornstein3.6-27B-MTP-NSC-ACE-SABER-F16.gguf"
)

$ErrorActionPreference = "Continue"
$ScriptDir = Split-Path -Parent $MyInvocation.MyCommand.Definition
$LogDir = "$ScriptDir\logs"
$ResultsDir = "$ScriptDir\results"
if (-not (Test-Path $LogDir)) { New-Item -ItemType Directory -Force -Path $LogDir | Out-Null }
if (-not (Test-Path $ResultsDir)) { New-Item -ItemType Directory -Force -Path $ResultsDir | Out-Null }
if (-not $ResultsFile) { $ResultsFile = "$ResultsDir\sweep_results.csv" }

# Write CSV header
"batch_size,ubatch_size,prompt_tok_s,decode_tok_s,prompt_ms,predicted_ms,prompt_tokens,gen_tokens,vram_mb_used,status" | Out-File -FilePath $ResultsFile -Encoding utf8 -Force

# Test matrix
$Sweeps = @(
    @{batch=256;  ubatches=@(64,128,256)},
    @{batch=512;  ubatches=@(64,128,256,512)},
    @{batch=1024; ubatches=@(64,128,256,512,1024)},
    @{batch=2048; ubatches=@(64,128,256,512,1024,2048)}
)

$BenchmarkPrompt = '{"prompt":"Explain the fundamental differences between classical cryptography and quantum cryptography, covering key distribution, encryption algorithms, and the impact of Shor factorization algorithm. Discuss practical considerations for post-quantum cryptography migration.","max_tokens":256,"stream":false}'
$WarmupPrompt   = '{"prompt":"Write a short sentence about machine learning.","max_tokens":64,"stream":false}'

function Get-VRAM {
    $smi = & nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>$null
    if ($smi) {
        if ($smi -is [array]) { return $smi[0].Trim() }
        return $smi.Trim()
    }
    return 0
}

function Ensure-ServerDead {
    taskkill /IM llama-server.exe /F 2>$null
    Start-Sleep -Milliseconds 500
    try {
        $null = Invoke-WebRequest -Uri "http://localhost:8081/health" -UseBasicParsing -TimeoutSec 1
        taskkill /IM llama-server.exe /F 2>$null
        Start-Sleep -Seconds 1
    } catch { }
}

function Build-CmdLine {
    param($batch, $ubatch, $logfile)
    
    # Build a properly-quoted command line string for cmd.exe
    # Each arg with spaces must be wrapped in escaped double-quotes
    $parts = @()
    $parts += "`"$Server`""
    $parts += "--threads 12"
    $parts += "--prio 3"
    $parts += "--n-predict 32768"
    $parts += "--batch-size $batch"
    $parts += "--ubatch-size $ubatch"
    $parts += "--flash-attn on"
    $parts += "--cache-type-k turbo4"
    $parts += "--cache-type-v turbo4"
    $parts += "--no-mmap"
    $parts += "--n-gpu-layers all"
    $parts += "--fit off"
    $parts += "--ctx-size 262144"
    $parts += "--model `"$ModelDir\$Model`""
    $parts += "--log-file `"$logfile`""
    $parts += "--offline"
    $parts += "--log-prefix"
    $parts += "--log-timestamps"
    $parts += "--cache-type-k-draft turbo4"
    $parts += "--cache-type-v-draft turbo4"
    $parts += "--temperature 1.0"
    $parts += "--top-p 0.95"
    $parts += "--min-p 0.0"
    $parts += "--repeat-penalty 1.0"
    $parts += "--presence-penalty 1.5"
    $parts += "--ctx-checkpoints 8"
    $parts += "--cache-ram 8192"
    $parts += "--kv-unified"
    $parts += "--parallel 1"
    $parts += "--mmproj `"$ModelDir\$MmpRoj`""
    $parts += "--no-mmproj-offload"
    $parts += "--image-min-tokens 1024"
    $parts += "--alias Qwen3.6-27B"
    $parts += "--host 0.0.0.0"
    $parts += "--port 8081"
    $parts += "--api-key dummythicc"
    $parts += "--props"
    $parts += "--reasoning on"
    $parts += '--chat-template-kwargs "{""preserve_thinking"":true}"'
    $parts += "--reasoning-budget 8192"
    $parts += '--reasoning-budget-message "My reasoning budget is exhausted, but I have enough information to answer directly now."'
    $parts += "--spec-type draft-mtp"
    $parts += "--spec-draft-n-max 2"
    $parts += "--spec-draft-p-min 0.75"
    
    return ($parts -join " ")
}

function Test-Config {
    param($Batch, $Ubatch)

    Write-Host "`n=============================================="
    Write-Host "TESTING: batch=$Batch  ubatch=$Ubatch"
    Write-Host "=============================================="

    Ensure-ServerDead
    $VramBefore = Get-VRAM
    Write-Host "[VRAM] Before load: ${VramBefore}MB"

    $TS = Get-Date -Format "yyyy-MM-dd_HH-mm-ss"
    $LogOut = "$LogDir\sweep_b${Batch}_u${Ubatch}_${TS}.log"
    $CmdLine = Build-CmdLine -batch $Batch -ubatch $Ubatch -logfile $LogOut
    
    Write-Host "[CMD] Starting server..."
    Write-Host "  $CmdLine"
    
    # Write a temp batch file and execute it so the window stays open
    $BatFile = "$LogDir\_run_b${Batch}_u${Ubatch}.bat"
    $Cwd = (Get-Location).Path
    @"
@echo off
cd /d "$Cwd"
$CmdLine
echo Server exited with code %errorlevel%
"@ | Out-File -FilePath $BatFile -Encoding ascii -Force

    $Proc = Start-Process -FilePath "cmd.exe" -ArgumentList "/c", "`"$BatFile`"" -PassThru -WindowStyle Normal

    # Wait for server ready (up to 120s)
    $Ready = $false
    for ($i = 0; $i -lt 120; $i++) {
        Start-Sleep -Seconds 1
        try {
            $test = Invoke-WebRequest -Uri "http://localhost:8081/health" -UseBasicParsing -TimeoutSec 5
            if ($test.StatusCode -eq 200) {
                $Ready = $true
                Write-Host "[OK] Server ready after ${i}s"
                break
            }
        } catch { }
    }

    if (-not $Ready) {
        Write-Host "[FAIL] Server did not start within 120s (likely OOM)"
        if (-not $Proc.HasExited) { $Proc.Kill() }
        $VramAfter = Get-VRAM
        return @{status="OOM"; decode=0; prompt=0; prompt_ms=0; gen_toks=0; prompt_toks=0; pred_ms=0; vram=$VramAfter}
    }

    $VramAfter = Get-VRAM
    Write-Host "[VRAM] After load: ${VramAfter}MB"

    # Warmup
    Write-Host "[WARMUP] Running 2 warmup requests..."
    for ($w = 1; $w -le 2; $w++) {
        try {
            $null = Invoke-WebRequest -Uri "http://localhost:8081/v1/completions" -Method Post `
                -Headers @{"Authorization"="Bearer dummythicc"; "Content-Type"="application/json"} `
                -Body $WarmupPrompt -UseBasicParsing -TimeoutSec 60
            Write-Host "  Warmup $w OK"
        } catch { Write-Warning "  Warmup $w failed: $_" }
    }

    # Benchmark - 3 requests
    Write-Host "[BENCH] Running 3 benchmark requests..."
    $DecodeScores = @()
    $PromptScores = @()
    $GenToks = @()
    $PredMss = @()

    for ($b = 1; $b -le 3; $b++) {
        try {
            $resp = Invoke-WebRequest -Uri "http://localhost:8081/v1/completions" -Method Post `
                -Headers @{"Authorization"="Bearer dummythicc"; "Content-Type"="application/json"} `
                -Body $BenchmarkPrompt -UseBasicParsing -TimeoutSec 120

            $json = $resp.Content | ConvertFrom-Json
            $timings = $json.timings

            $PromptScores += $timings.prompt_per_second
            $DecodeScores += $timings.predicted_per_second
            $GenToks += $json.usage.completion_tokens
            $PredMss += $timings.predicted_ms

            Write-Host "  [$b] prompt: $([math]::Round($timings.prompt_per_second,1)) tok/s | decode: $([math]::Round($timings.predicted_per_second,1)) tok/s | gen: $($json.usage.completion_tokens)toks"
        } catch { Write-Warning "  Request $b failed: $_" }
        Start-Sleep -Milliseconds 200
    }

    # Cleanup
    if (-not $Proc.HasExited) { $Proc.Kill() }
    Start-Sleep -Milliseconds 500
    taskkill /IM llama-server.exe /F 2>$null

    if ($DecodeScores.Count -gt 0) {
        $avgDecode = ($DecodeScores | Measure-Object -Average).Average
        $avgPrompt = ($PromptScores | Measure-Object -Average).Average
        $avgPredMs = ($PredMss | Measure-Object -Average).Average
        $avgGenToks = ($GenToks | Measure-Object -Average).Average

        Write-Host "[RESULT] batch=$Batch ubatch=$Ubatch => prompt: $([math]::Round($avgPrompt,1)) tok/s | decode: $([math]::Round($avgDecode,1)) tok/s"
        return @{status="ok"; decode=$avgDecode; prompt=$avgPrompt; prompt_ms=0; pred_ms=$avgPredMs; gen_toks=$avgGenToks; prompt_toks=0; vram=$VramAfter}
    } else {
        Write-Host "[FAIL] No valid benchmark results"
        return @{status="fail"; decode=0; prompt=0; prompt_ms=0; gen_toks=0; prompt_toks=0; pred_ms=0; vram=$VramAfter}
    }
}

# Run the sweep
foreach ($Sweep in $Sweeps) {
    $Batch = $Sweep.batch
    foreach ($Ubatch in $Sweep.ubatches) {
        $result = Test-Config -Batch $Batch -Ubatch $Ubatch
        "$($Batch),$($Ubatch),$([math]::Round($result.prompt,3)),$([math]::Round($result.decode,3)),$([math]::Round($result.prompt_ms,1)),$([math]::Round($result.pred_ms,1)),$($result.prompt_toks),$([math]::Round($result.gen_toks,1)),$($result.vram),$($result.status)" | Out-File -FilePath $ResultsFile -Encoding utf8 -Append
        Write-Host "--- CSV written for batch=$Batch ubatch=$Ubatch ---"
    }
}

Write-Host "`n=============================================="
Write-Host "SWEEP COMPLETE"
Write-Host "Results: $ResultsFile"
Write-Host "=============================================="
